# Copy this file to terraform.tfvars and fill in your values
# WARNING: terraform.tfvars contains sensitive data - DO NOT commit to git

project_id = "your-gcp-project-id"

# Optional: Override default values if needed
# region           = "us-east1"
# zone             = "us-east1-c"
# vm_name          = "discount-tracker-vm"
# machine_type     = "e2-micro"
# boot_disk_size   = 30

# GitHub repository URL - use SSH key or HTTPS with PAT for authentication
github_repo_url = "https://github.com/VSantos77/discount-tracker.git"

# Content of your .env file
# IMPORTANT: This should contain all required environment variables
env_file_content = <<-EOT
# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=discount_tracker
DB_USER=postgres
DB_PASSWORD=your-secure-password

# Scrapy Settings
ALLOWED_DOMAINS=example.com
COOKIES_ENABLED=false

# Other settings
API_KEY=your-api-key-here
DEBUG=false
EOT
